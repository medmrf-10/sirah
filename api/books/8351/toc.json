{"id": 8351, "slug": "نزهة-الأفكار-في-شرح-قرة-الأبصار", "title": "نزهة الأفكار في شرح قرة الأبصار", "author": "عبد القادر المجلسي", "death": "1337", "toc": [{"i": 0, "t": "مقدمة المصنف", "d": 0, "pg": 2}, {"i": 1, "t": "الكلام على البسملة", "d": 0, "pg": 5}, {"i": 2, "t": "والحمد لله الذي بأحمدا هدى", "d": 0, "pg": 8}, {"i": 3, "t": "بيان مبعث النبي", "d": 0, "pg": 28}, {"i": 4, "t": "لما نفخ في آدم الروح", "d": 0, "pg": 33}, {"i": 5, "t": "ما ولدني من سفاح الجاهلية شيء", "d": 0, "pg": 35}, {"i": 6, "t": "ولنذكر حين تم شرح هذه الأبيات", "d": 0, "pg": 39}, {"i": 7, "t": "من يعقوب إسرائيل الله", "d": 0, "pg": 45}, {"i": 8, "t": "\"بيان\" خير مبتدإ محذوف", "d": 0, "pg": 46}, {"i": 9, "t": "\"وحملت آمنة الزهرية\"", "d": 0, "pg": 48}, {"i": 10, "t": "\"وكان مولد النبي الهاد\"", "d": 0, "pg": 51}, {"i": 11, "t": "ولشهور القبط", "d": 0, "pg": 55}, {"i": 12, "t": "أولها الحمل بالتحريك ثم التور", "d": 0, "pg": 58}, {"i": 13, "t": "أصغر كوكب في السماء أكبر من الأرض بمائة وعشرين مرة", "d": 0, "pg": 61}, {"i": 14, "t": "وسأله أن يبعث له فيله محمود", "d": 0, "pg": 62}, {"i": 15, "t": "(فغاضت المياه) هذا من عجائب", "d": 0, "pg": 65}, {"i": 16, "t": "\"بيان\" خبر مبتدإ محذوف", "d": 0, "pg": 68}, {"i": 17, "t": "عفا جانب البطحاء من آل هاشم", "d": 0, "pg": 72}, {"i": 18, "t": "والصحيح أنها أسلمت", "d": 0, "pg": 73}, {"i": 19, "t": "حتى أن أحدهم إذا نزل به أذى يأخذ كفه", "d": 0, "pg": 78}, {"i": 20, "t": "فدلى عليها من السماء دلوا أبيض", "d": 0, "pg": 87}, {"i": 21, "t": "نبكي الفتاة البرة الأمينة", "d": 0, "pg": 91}, {"i": 22, "t": "(فرده خوفا من اليهود عليه)", "d": 0, "pg": 94}, {"i": 23, "t": "ثم أن خديجة ﵂ رغبت", "d": 0, "pg": 100}, {"i": 24, "t": "أول داخل رسول الله صلى الله عليه وسلم", "d": 0, "pg": 113}, {"i": 25, "t": "(بيان مبعث النبي الهادي)", "d": 0, "pg": 114}, {"i": 26, "t": "فقام يدعو الإنس والجن إلى)", "d": 0, "pg": 122}, {"i": 27, "t": "فكان أول دم أريق في سبيل الله", "d": 0, "pg": 126}, {"i": 28, "t": "(وكان قادرا على التدمير لو شاء)", "d": 0, "pg": 133}, {"i": 29, "t": "الجن على ثلاثة أصناف", "d": 0, "pg": 140}, {"i": 30, "t": "وفي الجن ملل", "d": 0, "pg": 143}, {"i": 31, "t": "أوتيت البراق وهو دابة أبيض", "d": 0, "pg": 145}, {"i": 32, "t": "أول من خط بالقلم", "d": 0, "pg": 148}, {"i": 33, "t": "(بيان هجرة النبي المختار)", "d": 0, "pg": 154}, {"i": 34, "t": "واهتز لموته عرش الرحمن", "d": 0, "pg": 159}, {"i": 35, "t": "تسح بردى هذا الأخضر", "d": 0, "pg": 162}, {"i": 36, "t": "وأما الجمع بأن نزول اقرأ في رمضان", "d": 0, "pg": 166}, {"i": 37, "t": "ما أكل منها جائع إلا شبع", "d": 0, "pg": 176}, {"i": 38, "t": "ونبتغي بذلك البركة", "d": 0, "pg": 186}, {"i": 39, "t": "يا دار خير المرسلين", "d": 0, "pg": 190}, {"i": 40, "t": "أوفوا بحلف الجاهلية", "d": 0, "pg": 192}, {"i": 41, "t": "أولها غزوة ودان", "d": 0, "pg": 194}, {"i": 42, "t": "هذا كتاب من محمد رسول الله", "d": 0, "pg": 197}, {"i": 43, "t": "أما غزوة بدر فهي أعظم", "d": 0, "pg": 200}, {"i": 44, "t": "لها سبعة أولاد شهدوا بدرا", "d": 0, "pg": 206}, {"i": 45, "t": "هنيئا زادك الرحمن فضلا", "d": 0, "pg": 210}, {"i": 46, "t": "واستشهد يومئذ أربعة عشر", "d": 0, "pg": 211}, {"i": 47, "t": "وبعدها غزوة أحد", "d": 0, "pg": 217}, {"i": 48, "t": "أنسيتم ما قال لكم رسول الله", "d": 0, "pg": 225}, {"i": 49, "t": "إذا الله جازى معشرا بفعالهم", "d": 0, "pg": 231}, {"i": 50, "t": "أنا ابن الذي سالت على الخد عينه", "d": 0, "pg": 233}, {"i": 51, "t": "غزوة حمراء الأسد", "d": 0, "pg": 237}, {"i": 52, "t": "غزوة دومة الجندل", "d": 0, "pg": 245}, {"i": 53, "t": "غزوة الخندق", "d": 0, "pg": 246}, {"i": 54, "t": "وليغتسل به سلمان", "d": 0, "pg": 248}, {"i": 55, "t": "فلم يقم لقريش حرب بعدها", "d": 0, "pg": 258}, {"i": 56, "t": "اللهم منزل الكتاب", "d": 0, "pg": 261}, {"i": 57, "t": "غزوة بني قريظة", "d": 0, "pg": 265}, {"i": 58, "t": "غزوة بني لحيان", "d": 0, "pg": 277}, {"i": 59, "t": "غزوة ذي قرد", "d": 0, "pg": 278}, {"i": 60, "t": "﴿لئن رجعنا إلى المدينة ليخرجن الأعز منها الأذل﴾", "d": 0, "pg": 282}, {"i": 61, "t": "قال أهل الإفك في الصديقية الطاهرة", "d": 0, "pg": 285}, {"i": 62, "t": "غزوة الحديبية", "d": 0, "pg": 287}, {"i": 63, "t": "وإذا توضأ كادوا يقتتلون على وضوئه", "d": 0, "pg": 293}, {"i": 64, "t": "فلما حصل الصلح اختلطوا بالمسلمين", "d": 0, "pg": 298}, {"i": 65, "t": "ثم خرج في بقية المحرم إلى خيبر", "d": 0, "pg": 304}, {"i": 66, "t": "وقتل من اليهود ثلاثة وتسعون", "d": 0, "pg": 312}, {"i": 67, "t": "ثم يلي خيبر فتح واد القرى", "d": 0, "pg": 317}, {"i": 68, "t": "غزوة القضاء", "d": 0, "pg": 320}, {"i": 69, "t": "غزوة مؤتة", "d": 0, "pg": 324}, {"i": 70, "t": "إن الله تعالى أبدله بيديه جناحين", "d": 0, "pg": 328}, {"i": 71, "t": "ثم بعد مؤتة غزوة فتح مكة", "d": 0, "pg": 335}, {"i": 72, "t": "فتشهد شهادة الحق وأسلم", "d": 0, "pg": 346}, {"i": 73, "t": "غزوة حنين", "d": 0, "pg": 364}, {"i": 74, "t": "ولما أسلمت ثقيف تكلمت أشرافهم", "d": 0, "pg": 382}, {"i": 75, "t": "والله ما فوها ببارد ولا ثديها بناهد", "d": 0, "pg": 382}, {"i": 76, "t": "اللهم لا تنسها لأبي سفيان", "d": 0, "pg": 383}, {"i": 77, "t": "ما طابت بهذا نفس أحد قط إلا نبيا", "d": 0, "pg": 385}, {"i": 78, "t": "غزوة بني سليم", "d": 0, "pg": 388}, {"i": 79, "t": "غزوة بني قينقاع", "d": 0, "pg": 390}, {"i": 80, "t": "ثم غزوة السويق", "d": 0, "pg": 392}, {"i": 81, "t": "غزوة غطفان", "d": 0, "pg": 395}, {"i": 82, "t": "غزوة بحران", "d": 0, "pg": 397}, {"i": 83, "t": "غزوة تبوك", "d": 0, "pg": 398}, {"i": 84, "t": "طلع البدر علينا", "d": 0, "pg": 405}, {"i": 85, "t": "والذي في النور أنها خمس وثلاثون", "d": 0, "pg": 409}, {"i": 86, "t": "ولنذكر كلاما مختصرا في البعوث", "d": 0, "pg": 412}, {"i": 87, "t": "ثم بعد ذلك سرية محمد بن مسلمة", "d": 0, "pg": 419}, {"i": 88, "t": "ثم سرية زيد بن حارثة إلى القردة", "d": 0, "pg": 423}, {"i": 89, "t": "ثم يلي ما مر بعث عبد الله بن عتيك", "d": 0, "pg": 426}, {"i": 90, "t": "فأتتهم فقتلت منهم سبعمائة رجل", "d": 0, "pg": 436}, {"i": 91, "t": "ويليه بعث أبي عبيدة بن الجراح", "d": 0, "pg": 442}, {"i": 92, "t": "أيها الناس إني قد أجرت أبا العاصي", "d": 0, "pg": 443}, {"i": 93, "t": "ثم سرية زيد سادسة إلى واد القرى", "d": 0, "pg": 448}, {"i": 94, "t": "سرية عبد الله بن عتيك", "d": 0, "pg": 453}, {"i": 95, "t": "سرية عبد الله بن رواحة", "d": 0, "pg": 455}, {"i": 96, "t": "قصة عكل وعرينة", "d": 0, "pg": 456}, {"i": 97, "t": "بعث عمرو بن أمية", "d": 0, "pg": 459}, {"i": 98, "t": "سرية غالب بن عبد الله", "d": 0, "pg": 462}, {"i": 99, "t": "قدوم خالد بن الوليد سيف الله الذي سله على الكفار", "d": 0, "pg": 466}, {"i": 100, "t": "سرية عمرو بن العاصي", "d": 0, "pg": 469}, {"i": 101, "t": "وابتاع قيس بن سعد الجواد بن الجواد جزرا", "d": 0, "pg": 472}, {"i": 102, "t": "ثم بعث خالد سيف الله", "d": 0, "pg": 477}, {"i": 103, "t": "ثم بعث قيس بن سعد بن عبادة", "d": 0, "pg": 483}, {"i": 104, "t": "ثم سرية عبد الله بن عوسجة", "d": 0, "pg": 486}, {"i": 105, "t": "ثم سرية علي بن أبي طالب", "d": 0, "pg": 488}, {"i": 106, "t": "شكرتك يد افتقرت بعد غنى", "d": 0, "pg": 489}, {"i": 107, "t": "والله لأن يهدي الله بك رجلا واحدا", "d": 0, "pg": 493}, {"i": 108, "t": "ثم سرية أسامة بن زيد", "d": 0, "pg": 495}, {"i": 109, "t": "(وقيل في النضير مع واد القرى قاتل)", "d": 0, "pg": 497}, {"i": 110, "t": "جزى الله عنا جعفرا حين أزلفت", "d": 0, "pg": 501}, {"i": 111, "t": "وأما غزوة الغابة", "d": 0, "pg": 502}, {"i": 112, "t": "(وحج حجتين ثم الفرضا)", "d": 0, "pg": 506}, {"i": 113, "t": "بيان أزواج النبي المصطفى", "d": 0, "pg": 510}, {"i": 114, "t": "وإن أول امرأة تزوج بها منهن خديجة", "d": 0, "pg": 514}, {"i": 115, "t": "أعطيت تسع خلال ما أعطيتهن امرأة", "d": 0, "pg": 520}, {"i": 116, "t": "وهاجرا في الدين هجرتين", "d": 0, "pg": 527}, {"i": 117, "t": "ومن مناقبها أنه شهد بدرا سبعة من أهلها", "d": 0, "pg": 531}, {"i": 118, "t": "أن أبا سلمة هو أول من هاجر إلى المدينة", "d": 0, "pg": 542}, {"i": 119, "t": "الوصيلة الناقة التي وصلت بين عشرة أبطن", "d": 0, "pg": 545}, {"i": 120, "t": "الحمد لله الملك القدوس السلام", "d": 0, "pg": 550}, {"i": 121, "t": "(بيان أولاد النبي أحمدا)", "d": 0, "pg": 562}, {"i": 122, "t": "ودعا النبي ﷺ بالبركة", "d": 0, "pg": 566}, {"i": 123, "t": "اللهم سلط عليه كلبا من كلابك", "d": 0, "pg": 578}, {"i": 124, "t": "(ثم تزوج ابن عفان الرضى رقية)", "d": 0, "pg": 579}, {"i": 125, "t": "والجمهور على أن مريم لم تكن نبية", "d": 0, "pg": 583}, {"i": 126, "t": "إن الله أمرني أن أزوج فاطمة من علي", "d": 0, "pg": 587}, {"i": 127, "t": "أما حسن فإن له هيبتي وسوددي وأما حسين فإن له جودي وجرأتي", "d": 0, "pg": 592}, {"i": 128, "t": "فلما ولى الفاطميون مصر قصروا الشرف على ذرية الحسن والحسين", "d": 0, "pg": 593}, {"i": 129, "t": "(بيان أعمام النبي المصطفى)", "d": 0, "pg": 598}, {"i": 130, "t": "حمزة أسد الله وأسد رسوله", "d": 0, "pg": 601}, {"i": 131, "t": "وكان عمر يستسقي بالعباس عام الرمادة", "d": 0, "pg": 605}, {"i": 132, "t": "(عماته صفية المبره)", "d": 0, "pg": 609}, {"i": 133, "t": "(أخواله الأسود مع عمير)", "d": 0, "pg": 612}, {"i": 134, "t": "(بيان ما له من الموالي)", "d": 0, "pg": 613}, {"i": 135, "t": "بكيت على زيد فلم أدر ما فعل أحي فيرجى", "d": 0, "pg": 615}, {"i": 136, "t": "(أما سراريه سوى القبطيه فهي ثلاث", "d": 0, "pg": 628}, {"i": 137, "t": "فغرس ﵇ الكل بيده وقال أعينوا صاحبكم", "d": 0, "pg": 631}, {"i": 138, "t": "فلقد دفنت من صلبي سوى ولد ولدي مائة وخمسة وعشرين", "d": 0, "pg": 634}, {"i": 139, "t": "(بيان حراس النبي المصطفى", "d": 0, "pg": 640}, {"i": 140, "t": "وبدء من الأنصار عدمها جرا", "d": 0, "pg": 641}, {"i": 141, "t": "وقصة اليهودي الذي أظهر الإسلام والتنسك", "d": 0, "pg": 644}, {"i": 142, "t": "(بيان رسل المصطفى لمن ملك)", "d": 0, "pg": 647}, {"i": 143, "t": "بسم الله الرحمن الرحيم من محمد", "d": 0, "pg": 649}, {"i": 144, "t": "من محمد رسول الله إلى كسرى عظيم فارس", "d": 0, "pg": 654}, {"i": 145, "t": "إلى المقوقس بعد البسملة من محمد", "d": 0, "pg": 658}, {"i": 146, "t": "لطيفة وهي إسلام صحابي على يد تابعي", "d": 0, "pg": 662}, {"i": 147, "t": "أما أن اليمامة سيظهر فيها كذاب", "d": 0, "pg": 664}, {"i": 148, "t": "وهو أول من بنى مسجدا في أرض الكفر", "d": 0, "pg": 667}, {"i": 149, "t": "من محمد رسول الله إلى مسيلمة الكذاب", "d": 0, "pg": 671}, {"i": 150, "t": "(بيان من كان من الكتاب له)", "d": 0, "pg": 674}, {"i": 151, "t": "وقتله بعد أن أحرم في صلاة الصبح أبو لؤلوة فيروز", "d": 0, "pg": 678}, {"i": 152, "t": "أحذر ليلا تهلك أن تعتقد أن أحدا من الصحابة", "d": 0, "pg": 679}, {"i": 153, "t": "أتى ابن ملجم الكوفة واختفى وتزوج فطام", "d": 0, "pg": 681}, {"i": 154, "t": "وأجيزت وصيته بعد الموت", "d": 0, "pg": 681}, {"i": 155, "t": "أمه سمية فكانت أول شهيد في الإسلام", "d": 0, "pg": 683}, {"i": 156, "t": "وروى أنها القرية التي كانت حاضرة البحر", "d": 0, "pg": 690}, {"i": 157, "t": "(بيان من يقطع بالجنان لهم)", "d": 0, "pg": 694}, {"i": 158, "t": "تأتي الملائكة بأبي بكر مع النبيئين تزفه", "d": 0, "pg": 695}, {"i": 159, "t": "كان إسلام عمر عزا وهجرته نصرا وإمارته رحمة", "d": 0, "pg": 696}, {"i": 160, "t": "والله ليشفعن عثمان في سبعين ألفا من أمته", "d": 0, "pg": 697}, {"i": 161, "t": "وهو أول من أذن للنبي صلى الله تعالى عليه وسلم", "d": 0, "pg": 700}, {"i": 162, "t": "جبريل أعان حسان بسبعين بيتا", "d": 0, "pg": 706}, {"i": 163, "t": "(ذكر دوابه عليه أفضل صلاة ربي)", "d": 0, "pg": 707}, {"i": 164, "t": "(بيان ما له من السلاح)", "d": 0, "pg": 731}, {"i": 165, "t": "أنها تأكل ولم تشرب بعد موته عليه السلام", "d": 0, "pg": 731}, {"i": 166, "t": "لا سيف إلا ذو الفقار ولا فتى إلا علي", "d": 0, "pg": 732}, {"i": 167, "t": "من الأسياف السبعة التي أهدت بلقيس إلى سليمان", "d": 0, "pg": 734}, {"i": 168, "t": "درع داوود التي لبسها حين قتل جالوت", "d": 0, "pg": 738}, {"i": 169, "t": "(بيان ما له من الثياب)", "d": 0, "pg": 742}, {"i": 170, "t": "تغسل للمرضى وتسقى لهم", "d": 0, "pg": 743}, {"i": 171, "t": "المباهات في الملابس والتزين بها", "d": 0, "pg": 745}, {"i": 172, "t": "تطلب الشفاء لملابستها لعرقه وبدنه", "d": 0, "pg": 748}, {"i": 173, "t": "من جر شيئا من ذلك خيلاء لم ينظر الله إليه", "d": 0, "pg": 750}, {"i": 174, "t": "إذا قام من الليل يشوص فاه بالسواك", "d": 0, "pg": 753}, {"i": 175, "t": "فراش للرجل وفراش لامرأته والثالث للضيف", "d": 0, "pg": 756}, {"i": 176, "t": "كسرى وقيصر على الخز والديباج", "d": 0, "pg": 757}, {"i": 177, "t": "فطلبته الناس يحملون عليه موتاهم", "d": 0, "pg": 763}, {"i": 178, "t": "لأن صيانة العرض بترك سنة واجب", "d": 0, "pg": 764}, {"i": 179, "t": "من أمسك تمثالها متبركا به آمن من بغى البغاة", "d": 0, "pg": 771}, {"i": 180, "t": "واجعله في منى هذا الشرح رجاء لبركته", "d": 0, "pg": 773}, {"i": 181, "t": "النعل", "d": 0, "pg": 777}, {"i": 182, "t": "(بيان بعض معجزات المصطفى)", "d": 0, "pg": 779}, {"i": 183, "t": "فجعلها مائة قلوص إلى تسع سنين", "d": 0, "pg": 786}, {"i": 184, "t": "ولنذكر أولا حديث مسلم في الإسراء", "d": 0, "pg": 790}, {"i": 185, "t": "ها أنت وربك فهذا مقامي لا أتعداه", "d": 0, "pg": 795}, {"i": 186, "t": "من قام بعشر آيات لم يكتب من الغافلين", "d": 0, "pg": 796}, {"i": 187, "t": "يا محمد ارفع رأسك سل تعط واشفع تشفع", "d": 0, "pg": 798}, {"i": 188, "t": "اقتلع قرى قوم لوط وحملها على جناحه", "d": 0, "pg": 801}, {"i": 189, "t": "لم يكن الوجوب مبرما", "d": 0, "pg": 804}, {"i": 190, "t": "وذكره ابن الجوزي في الموضوعات فأخطأ", "d": 0, "pg": 808}, {"i": 191, "t": "إن فيه لعنكبوتا أقدم من ميلاد محمد", "d": 0, "pg": 815}, {"i": 192, "t": "الحمد لله الذي سلبهما كسرى بن هرمز", "d": 0, "pg": 817}, {"i": 193, "t": "والأصح أنها نعجة بيضاء", "d": 0, "pg": 818}, {"i": 194, "t": "بشر المشائين في الظلم إلى المساجد", "d": 0, "pg": 823}, {"i": 195, "t": "(وأخبرتك الشاة بعد الشي بأنها سمت", "d": 0, "pg": 826}, {"i": 196, "t": "فقال له جزاءا لي يا رسول الله", "d": 0, "pg": 827}, {"i": 197, "t": "وأما سجود الجمل له فعن أنس", "d": 0, "pg": 829}, {"i": 198, "t": "لأمرت المرأة أن تسجد لزوجها من عظم حقه", "d": 0, "pg": 829}, {"i": 199, "t": "لا حاجة لي بهما وجدت الله خيرا لي منهما", "d": 0, "pg": 835}, {"i": 200, "t": "بل تغرسني في الجنة فيأكل مني أولياء الله", "d": 0, "pg": 839}, {"i": 201, "t": "اللهم إني أسألك وأتوجه إليك بنبيك محمد", "d": 0, "pg": 842}, {"i": 202, "t": "ما أرسل الرحمن أو يرسل", "d": 0, "pg": 843}, {"i": 203, "t": "وكان عتبة أطيب منهن ريحا مع أنه لا يمس طيبا", "d": 0, "pg": 845}, {"i": 204, "t": "ودعا لمعاوية بالتمكين في البلاد فنال ذلك", "d": 0, "pg": 851}, {"i": 205, "t": "فجاء الأسد يتشمم وجوههم حتى ضرب عتيبة", "d": 0, "pg": 852}, {"i": 206, "t": "وهاتان العلامتان لم تكونا منذ خلقت الدنيا", "d": 0, "pg": 854}, {"i": 207, "t": "ومنها أن آدم وجميع المخلوقات خلقوا لأجله", "d": 0, "pg": 857}, {"i": 208, "t": "(ذكر وفاته صلاة ربه عليه)", "d": 0, "pg": 857}, {"i": 209, "t": "اللهم في الرفيق الأعلى", "d": 0, "pg": 862}, {"i": 210, "t": "من تصبح بسبع تمرات عجوة لم يضره", "d": 0, "pg": 864}, {"i": 211, "t": "ومنها مده يده لسيدي أحمد الرفاعي", "d": 0, "pg": 867}, {"i": 212, "t": "من كان يعبد محمدا فإن محمدا قد مات", "d": 0, "pg": 870}, {"i": 213, "t": "(وجاء الخضر معزيا لهم)", "d": 0, "pg": 873}, {"i": 214, "t": "يا روضة طاب منها الرق والقلم", "d": 0, "pg": 887}, {"i": 215, "t": "(بيان ما له من الأسماء)", "d": 0, "pg": 890}, {"i": 216, "t": "من رآه بديهة هابه", "d": 0, "pg": 892}, {"i": 217, "t": "لولا هو ﵇ ما خلق قمر ولا شمس ولا بر", "d": 0, "pg": 895}, {"i": 218, "t": "تقول فيه بلسان ناعت أبلج وجه", "d": 0, "pg": 897}, {"i": 219, "t": "أرى كل مدح في النبي مقصرا", "d": 0, "pg": 905}, {"i": 220, "t": "فيقول يا رب أمتي أمتي", "d": 0, "pg": 907}, {"i": 221, "t": "من العباد من ينسي الله حفظته ذنوبه", "d": 0, "pg": 909}, {"i": 222, "t": "وأنا توسلنا إليك بعم نبينا فاسقنا", "d": 0, "pg": 910}, {"i": 223, "t": "الراحمون يرحمهم الله", "d": 0, "pg": 919}, {"i": 224, "t": "تعرض عليه أعمال أمته يستغفر لهم", "d": 0, "pg": 923}, {"i": 225, "t": "اختلف في عدة الصحابة الذين توفى ﷺ عنهم", "d": 0, "pg": 925}]}