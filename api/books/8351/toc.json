{"id": 8351, "slug": "نزهة-الأفكار-في-شرح-قرة-الأبصار", "title": "نزهة الأفكار في شرح قرة الأبصار", "author": "عبد القادر المجلسي", "death": "1337", "toc": [{"i": 0, "t": "مقدمة المصنف", "d": 0, "pg": 1, "j": "1", "sz": 1433}, {"i": 1, "t": "الكلام على البسملة", "d": 0, "pg": 4, "j": "1", "sz": 44119}, {"i": 2, "t": "والحمد لله الذي بأحمدا هدى", "d": 0, "pg": 7, "j": "1", "sz": 1660}, {"i": 3, "t": "بيان مبعث النبي", "d": 0, "pg": 27, "j": "1", "sz": 1474}, {"i": 4, "t": "لما نفخ في آدم الروح", "d": 0, "pg": 32, "j": "1", "sz": 1323}, {"i": 5, "t": "ما ولدني من سفاح الجاهلية شيء", "d": 0, "pg": 34, "j": "1", "sz": 7019}, {"i": 6, "t": "ولنذكر حين تم شرح هذه الأبيات", "d": 0, "pg": 38, "j": "1", "sz": 9840}, {"i": 7, "t": "من يعقوب إسرائيل الله", "d": 0, "pg": 44, "j": "1", "sz": 3678}, {"i": 8, "t": "\"بيان\" خير مبتدإ محذوف", "d": 0, "pg": 45, "j": "1", "sz": 1483}, {"i": 9, "t": "\"وحملت آمنة الزهرية\"", "d": 0, "pg": 47, "j": "1", "sz": 11494}, {"i": 10, "t": "\"وكان مولد النبي الهاد\"", "d": 0, "pg": 50, "j": "1", "sz": 1437}, {"i": 11, "t": "ولشهور القبط", "d": 0, "pg": 54, "j": "1", "sz": 8287}, {"i": 12, "t": "أولها الحمل بالتحريك ثم التور", "d": 0, "pg": 57, "j": "1", "sz": 1551}, {"i": 13, "t": "أصغر كوكب في السماء أكبر من الأرض بمائة وعشرين مرة", "d": 0, "pg": 60, "j": "1", "sz": 1721}, {"i": 14, "t": "وسأله أن يبعث له فيله محمود", "d": 0, "pg": 61, "j": "1", "sz": 4715}, {"i": 15, "t": "(فغاضت المياه) هذا من عجائب", "d": 0, "pg": 64, "j": "1", "sz": 10598}, {"i": 16, "t": "\"بيان\" خبر مبتدإ محذوف", "d": 0, "pg": 67, "j": "1", "sz": 1589}, {"i": 17, "t": "عفا جانب البطحاء من آل هاشم", "d": 0, "pg": 71, "j": "1", "sz": 2420}, {"i": 18, "t": "والصحيح أنها أسلمت", "d": 0, "pg": 72, "j": "1", "sz": 59315}, {"i": 19, "t": "حتى أن أحدهم إذا نزل به أذى يأخذ كفه", "d": 0, "pg": 77, "j": "1", "sz": 1529}, {"i": 20, "t": "فدلى عليها من السماء دلوا أبيض", "d": 0, "pg": 86, "j": "1", "sz": 1523}, {"i": 21, "t": "نبكي الفتاة البرة الأمينة", "d": 0, "pg": 90, "j": "1", "sz": 1455}, {"i": 22, "t": "(فرده خوفا من اليهود عليه)", "d": 0, "pg": 93, "j": "1", "sz": 1497}, {"i": 23, "t": "ثم أن خديجة ﵂ رغبت", "d": 0, "pg": 99, "j": "1", "sz": 1527}, {"i": 24, "t": "أول داخل رسول الله صلى الله عليه وسلم", "d": 0, "pg": 112, "j": "1", "sz": 2536}, {"i": 25, "t": "(بيان مبعث النبي الهادي)", "d": 0, "pg": 113, "j": "1", "sz": 11571}, {"i": 26, "t": "فقام يدعو الإنس والجن إلى)", "d": 0, "pg": 121, "j": "1", "sz": 6966}, {"i": 27, "t": "فكان أول دم أريق في سبيل الله", "d": 0, "pg": 125, "j": "1", "sz": 10970}, {"i": 28, "t": "(وكان قادرا على التدمير لو شاء)", "d": 0, "pg": 132, "j": "1", "sz": 10039}, {"i": 29, "t": "الجن على ثلاثة أصناف", "d": 0, "pg": 139, "j": "1", "sz": 4614}, {"i": 30, "t": "وفي الجن ملل", "d": 0, "pg": 142, "j": "1", "sz": 8852}, {"i": 31, "t": "أوتيت البراق وهو دابة أبيض", "d": 0, "pg": 144, "j": "1", "sz": 1718}, {"i": 32, "t": "أول من خط بالقلم", "d": 0, "pg": 147, "j": "1", "sz": 8789}, {"i": 33, "t": "(بيان هجرة النبي المختار)", "d": 0, "pg": 153, "j": "1", "sz": 6940}, {"i": 34, "t": "واهتز لموته عرش الرحمن", "d": 0, "pg": 158, "j": "1", "sz": 27432}, {"i": 35, "t": "تسح بردى هذا الأخضر", "d": 0, "pg": 161, "j": "1", "sz": 1539}, {"i": 36, "t": "وأما الجمع بأن نزول اقرأ في رمضان", "d": 0, "pg": 165, "j": "1", "sz": 1559}, {"i": 37, "t": "ما أكل منها جائع إلا شبع", "d": 0, "pg": 175, "j": "1", "sz": 20495}, {"i": 38, "t": "ونبتغي بذلك البركة", "d": 0, "pg": 185, "j": "1", "sz": 1505}, {"i": 39, "t": "يا دار خير المرسلين", "d": 0, "pg": 189, "j": "1", "sz": 6461}, {"i": 40, "t": "أوفوا بحلف الجاهلية", "d": 0, "pg": 191, "j": "1", "sz": 1405}, {"i": 41, "t": "أولها غزوة ودان", "d": 0, "pg": 193, "j": "1", "sz": 5155}, {"i": 42, "t": "هذا كتاب من محمد رسول الله", "d": 0, "pg": 196, "j": "1", "sz": 3907}, {"i": 43, "t": "أما غزوة بدر فهي أعظم", "d": 0, "pg": 199, "j": "1", "sz": 10517}, {"i": 44, "t": "لها سبعة أولاد شهدوا بدرا", "d": 0, "pg": 205, "j": "1", "sz": 6102}, {"i": 45, "t": "هنيئا زادك الرحمن فضلا", "d": 0, "pg": 209, "j": "1", "sz": 2849}, {"i": 46, "t": "واستشهد يومئذ أربعة عشر", "d": 0, "pg": 210, "j": "1", "sz": 8404}, {"i": 47, "t": "وبعدها غزوة أحد", "d": 0, "pg": 216, "j": "1", "sz": 12214}, {"i": 48, "t": "أنسيتم ما قال لكم رسول الله", "d": 0, "pg": 224, "j": "1", "sz": 12610}, {"i": 49, "t": "إذا الله جازى معشرا بفعالهم", "d": 0, "pg": 230, "j": "1", "sz": 1428}, {"i": 50, "t": "أنا ابن الذي سالت على الخد عينه", "d": 0, "pg": 232, "j": "1", "sz": 4861}, {"i": 51, "t": "غزوة حمراء الأسد", "d": 0, "pg": 236, "j": "1", "sz": 12379}, {"i": 52, "t": "غزوة دومة الجندل", "d": 0, "pg": 244, "j": "1", "sz": 2019}, {"i": 53, "t": "غزوة الخندق", "d": 0, "pg": 245, "j": "1", "sz": 4174}, {"i": 54, "t": "وليغتسل به سلمان", "d": 0, "pg": 247, "j": "1", "sz": 14118}, {"i": 55, "t": "فلم يقم لقريش حرب بعدها", "d": 0, "pg": 257, "j": "1", "sz": 5788}, {"i": 56, "t": "اللهم منزل الكتاب", "d": 0, "pg": 260, "j": "1", "sz": 4318}, {"i": 57, "t": "غزوة بني قريظة", "d": 0, "pg": 264, "j": "1", "sz": 18707}, {"i": 58, "t": "غزوة بني لحيان", "d": 0, "pg": 276, "j": "1", "sz": 2136}, {"i": 59, "t": "غزوة ذي قرد", "d": 0, "pg": 277, "j": "1", "sz": 6109}, {"i": 60, "t": "﴿لئن رجعنا إلى المدينة ليخرجن الأعز منها الأذل﴾", "d": 0, "pg": 281, "j": "1", "sz": 4768}, {"i": 61, "t": "قال أهل الإفك في الصديقية الطاهرة", "d": 0, "pg": 284, "j": "1", "sz": 3990}, {"i": 62, "t": "غزوة الحديبية", "d": 0, "pg": 286, "j": "1", "sz": 9359}, {"i": 63, "t": "وإذا توضأ كادوا يقتتلون على وضوئه", "d": 0, "pg": 292, "j": "1", "sz": 7964}, {"i": 64, "t": "فلما حصل الصلح اختلطوا بالمسلمين", "d": 0, "pg": 297, "j": "1", "sz": 8349}, {"i": 65, "t": "ثم خرج في بقية المحرم إلى خيبر", "d": 0, "pg": 303, "j": "1", "sz": 20731}, {"i": 66, "t": "وقتل من اليهود ثلاثة وتسعون", "d": 0, "pg": 311, "j": "1", "sz": 1492}, {"i": 67, "t": "ثم يلي خيبر فتح واد القرى", "d": 0, "pg": 316, "j": "1", "sz": 3600}, {"i": 68, "t": "غزوة القضاء", "d": 0, "pg": 319, "j": "1", "sz": 6727}, {"i": 69, "t": "غزوة مؤتة", "d": 0, "pg": 323, "j": "1", "sz": 7961}, {"i": 70, "t": "إن الله تعالى أبدله بيديه جناحين", "d": 0, "pg": 327, "j": "1", "sz": 8884}, {"i": 71, "t": "ثم بعد مؤتة غزوة فتح مكة", "d": 0, "pg": 334, "j": "1", "sz": 50382}, {"i": 72, "t": "فتشهد شهادة الحق وأسلم", "d": 0, "pg": 345, "j": "1", "sz": 1874}, {"i": 73, "t": "غزوة حنين", "d": 0, "pg": 363, "j": "1", "sz": 29282}, {"i": 74, "t": "ولما أسلمت ثقيف تكلمت أشرافهم", "d": 0, "pg": 381, "j": "1", "sz": 1318}, {"i": 75, "t": "والله ما فوها ببارد ولا ثديها بناهد", "d": 0, "pg": 381, "j": "1", "sz": 587}, {"i": 76, "t": "اللهم لا تنسها لأبي سفيان", "d": 0, "pg": 382, "j": "1", "sz": 7847}, {"i": 77, "t": "ما طابت بهذا نفس أحد قط إلا نبيا", "d": 0, "pg": 384, "j": "1", "sz": 1491}, {"i": 78, "t": "غزوة بني سليم", "d": 0, "pg": 387, "j": "1", "sz": 2051}, {"i": 79, "t": "غزوة بني قينقاع", "d": 0, "pg": 389, "j": "1", "sz": 3084}, {"i": 80, "t": "ثم غزوة السويق", "d": 0, "pg": 391, "j": "1", "sz": 4341}, {"i": 81, "t": "غزوة غطفان", "d": 0, "pg": 394, "j": "1", "sz": 3653}, {"i": 82, "t": "غزوة بحران", "d": 0, "pg": 396, "j": "1", "sz": 854}, {"i": 83, "t": "غزوة تبوك", "d": 0, "pg": 397, "j": "1", "sz": 11219}, {"i": 84, "t": "طلع البدر علينا", "d": 0, "pg": 404, "j": "1", "sz": 11371}, {"i": 85, "t": "والذي في النور أنها خمس وثلاثون", "d": 0, "pg": 408, "j": "1", "sz": 1542}, {"i": 86, "t": "ولنذكر كلاما مختصرا في البعوث", "d": 0, "pg": 411, "j": "1", "sz": 9559}, {"i": 87, "t": "ثم بعد ذلك سرية محمد بن مسلمة", "d": 0, "pg": 418, "j": "1", "sz": 6029}, {"i": 88, "t": "ثم سرية زيد بن حارثة إلى القردة", "d": 0, "pg": 422, "j": "1", "sz": 20666}, {"i": 89, "t": "ثم يلي ما مر بعث عبد الله بن عتيك", "d": 0, "pg": 425, "j": "1", "sz": 1583}, {"i": 90, "t": "فأتتهم فقتلت منهم سبعمائة رجل", "d": 0, "pg": 435, "j": "1", "sz": 8130}, {"i": 91, "t": "ويليه بعث أبي عبيدة بن الجراح", "d": 0, "pg": 441, "j": "1", "sz": 2379}, {"i": 92, "t": "أيها الناس إني قد أجرت أبا العاصي", "d": 0, "pg": 442, "j": "1", "sz": 6559}, {"i": 93, "t": "ثم سرية زيد سادسة إلى واد القرى", "d": 0, "pg": 447, "j": "1", "sz": 6783}, {"i": 94, "t": "سرية عبد الله بن عتيك", "d": 0, "pg": 1, "j": "2", "sz": 4309}, {"i": 95, "t": "سرية عبد الله بن رواحة", "d": 0, "pg": 3, "j": "2", "sz": 1401}, {"i": 96, "t": "قصة عكل وعرينة", "d": 0, "pg": 4, "j": "2", "sz": 4062}, {"i": 97, "t": "بعث عمرو بن أمية", "d": 0, "pg": 7, "j": "2", "sz": 19243}, {"i": 98, "t": "سرية غالب بن عبد الله", "d": 0, "pg": 10, "j": "2", "sz": 1520}, {"i": 99, "t": "قدوم خالد بن الوليد سيف الله الذي سله على الكفار", "d": 0, "pg": 14, "j": "2", "sz": 1335}, {"i": 100, "t": "سرية عمرو بن العاصي", "d": 0, "pg": 17, "j": "2", "sz": 1588}, {"i": 101, "t": "وابتاع قيس بن سعد الجواد بن الجواد جزرا", "d": 0, "pg": 20, "j": "2", "sz": 8234}, {"i": 102, "t": "ثم بعث خالد سيف الله", "d": 0, "pg": 25, "j": "2", "sz": 7680}, {"i": 103, "t": "ثم بعث قيس بن سعد بن عبادة", "d": 0, "pg": 31, "j": "2", "sz": 4921}, {"i": 104, "t": "ثم سرية عبد الله بن عوسجة", "d": 0, "pg": 34, "j": "2", "sz": 3344}, {"i": 105, "t": "ثم سرية علي بن أبي طالب", "d": 0, "pg": 36, "j": "2", "sz": 1006}, {"i": 106, "t": "شكرتك يد افتقرت بعد غنى", "d": 0, "pg": 37, "j": "2", "sz": 12841}, {"i": 107, "t": "والله لأن يهدي الله بك رجلا واحدا", "d": 0, "pg": 41, "j": "2", "sz": 1487}, {"i": 108, "t": "ثم سرية أسامة بن زيد", "d": 0, "pg": 43, "j": "2", "sz": 1611}, {"i": 109, "t": "(وقيل في النضير مع واد القرى قاتل)", "d": 0, "pg": 45, "j": "2", "sz": 6705}, {"i": 110, "t": "جزى الله عنا جعفرا حين أزلفت", "d": 0, "pg": 49, "j": "2", "sz": 1514}, {"i": 111, "t": "وأما غزوة الغابة", "d": 0, "pg": 50, "j": "2", "sz": 12083}, {"i": 112, "t": "(وحج حجتين ثم الفرضا)", "d": 0, "pg": 54, "j": "2", "sz": 1583}, {"i": 113, "t": "بيان أزواج النبي المصطفى", "d": 0, "pg": 58, "j": "2", "sz": 25413}, {"i": 114, "t": "وإن أول امرأة تزوج بها منهن خديجة", "d": 0, "pg": 62, "j": "2", "sz": 1283}, {"i": 115, "t": "أعطيت تسع خلال ما أعطيتهن امرأة", "d": 0, "pg": 68, "j": "2", "sz": 1574}, {"i": 116, "t": "وهاجرا في الدين هجرتين", "d": 0, "pg": 75, "j": "2", "sz": 5129}, {"i": 117, "t": "ومن مناقبها أنه شهد بدرا سبعة من أهلها", "d": 0, "pg": 79, "j": "2", "sz": 16957}, {"i": 118, "t": "أن أبا سلمة هو أول من هاجر إلى المدينة", "d": 0, "pg": 90, "j": "2", "sz": 4386}, {"i": 119, "t": "الوصيلة الناقة التي وصلت بين عشرة أبطن", "d": 0, "pg": 93, "j": "2", "sz": 7415}, {"i": 120, "t": "الحمد لله الملك القدوس السلام", "d": 0, "pg": 98, "j": "2", "sz": 16607}, {"i": 121, "t": "(بيان أولاد النبي أحمدا)", "d": 0, "pg": 110, "j": "2", "sz": 31738}, {"i": 122, "t": "ودعا النبي ﷺ بالبركة", "d": 0, "pg": 114, "j": "2", "sz": 1603}, {"i": 123, "t": "اللهم سلط عليه كلبا من كلابك", "d": 0, "pg": 126, "j": "2", "sz": 1578}, {"i": 124, "t": "(ثم تزوج ابن عفان الرضى رقية)", "d": 0, "pg": 127, "j": "2", "sz": 1322}, {"i": 125, "t": "والجمهور على أن مريم لم تكن نبية", "d": 0, "pg": 131, "j": "2", "sz": 6705}, {"i": 126, "t": "إن الله أمرني أن أزوج فاطمة من علي", "d": 0, "pg": 135, "j": "2", "sz": 6732}, {"i": 127, "t": "أما حسن فإن له هيبتي وسوددي وأما حسين فإن له جودي وجرأتي", "d": 0, "pg": 140, "j": "2", "sz": 8415}, {"i": 128, "t": "فلما ولى الفاطميون مصر قصروا الشرف على ذرية الحسن والحسين", "d": 0, "pg": 141, "j": "2", "sz": 1533}, {"i": 129, "t": "(بيان أعمام النبي المصطفى)", "d": 0, "pg": 146, "j": "2", "sz": 4958}, {"i": 130, "t": "حمزة أسد الله وأسد رسوله", "d": 0, "pg": 149, "j": "2", "sz": 5594}, {"i": 131, "t": "وكان عمر يستسقي بالعباس عام الرمادة", "d": 0, "pg": 153, "j": "2", "sz": 4589}, {"i": 132, "t": "(عماته صفية المبره)", "d": 0, "pg": 157, "j": "2", "sz": 5455}, {"i": 133, "t": "(أخواله الأسود مع عمير)", "d": 0, "pg": 160, "j": "2", "sz": 449}, {"i": 134, "t": "(بيان ما له من الموالي)", "d": 0, "pg": 161, "j": "2", "sz": 21183}, {"i": 135, "t": "بكيت على زيد فلم أدر ما فعل أحي فيرجى", "d": 0, "pg": 163, "j": "2", "sz": 1357}, {"i": 136, "t": "(أما سراريه سوى القبطيه فهي ثلاث", "d": 0, "pg": 176, "j": "2", "sz": 14867}, {"i": 137, "t": "فغرس ﵇ الكل بيده وقال أعينوا صاحبكم", "d": 0, "pg": 179, "j": "2", "sz": 1403}, {"i": 138, "t": "فلقد دفنت من صلبي سوى ولد ولدي مائة وخمسة وعشرين", "d": 0, "pg": 182, "j": "2", "sz": 1150}, {"i": 139, "t": "(بيان حراس النبي المصطفى", "d": 0, "pg": 188, "j": "2", "sz": 5477}, {"i": 140, "t": "وبدء من الأنصار عدمها جرا", "d": 0, "pg": 189, "j": "2", "sz": 1224}, {"i": 141, "t": "وقصة اليهودي الذي أظهر الإسلام والتنسك", "d": 0, "pg": 192, "j": "2", "sz": 3980}, {"i": 142, "t": "(بيان رسل المصطفى لمن ملك)", "d": 0, "pg": 195, "j": "2", "sz": 2535}, {"i": 143, "t": "بسم الله الرحمن الرحيم من محمد", "d": 0, "pg": 197, "j": "2", "sz": 12561}, {"i": 144, "t": "من محمد رسول الله إلى كسرى عظيم فارس", "d": 0, "pg": 202, "j": "2", "sz": 1561}, {"i": 145, "t": "إلى المقوقس بعد البسملة من محمد", "d": 0, "pg": 206, "j": "2", "sz": 7323}, {"i": 146, "t": "لطيفة وهي إسلام صحابي على يد تابعي", "d": 0, "pg": 210, "j": "2", "sz": 2908}, {"i": 147, "t": "أما أن اليمامة سيظهر فيها كذاب", "d": 0, "pg": 212, "j": "2", "sz": 4208}, {"i": 148, "t": "وهو أول من بنى مسجدا في أرض الكفر", "d": 0, "pg": 215, "j": "2", "sz": 5572}, {"i": 149, "t": "من محمد رسول الله إلى مسيلمة الكذاب", "d": 0, "pg": 219, "j": "2", "sz": 3028}, {"i": 150, "t": "(بيان من كان من الكتاب له)", "d": 0, "pg": 222, "j": "2", "sz": 6227}, {"i": 151, "t": "وقتله بعد أن أحرم في صلاة الصبح أبو لؤلوة فيروز", "d": 0, "pg": 226, "j": "2", "sz": 1744}, {"i": 152, "t": "أحذر ليلا تهلك أن تعتقد أن أحدا من الصحابة", "d": 0, "pg": 227, "j": "2", "sz": 4345}, {"i": 153, "t": "أتى ابن ملجم الكوفة واختفى وتزوج فطام", "d": 0, "pg": 229, "j": "2", "sz": 1586}, {"i": 154, "t": "وأجيزت وصيته بعد الموت", "d": 0, "pg": 229, "j": "2", "sz": 1797}, {"i": 155, "t": "أمه سمية فكانت أول شهيد في الإسلام", "d": 0, "pg": 231, "j": "2", "sz": 9922}, {"i": 156, "t": "وروى أنها القرية التي كانت حاضرة البحر", "d": 0, "pg": 238, "j": "2", "sz": 5266}, {"i": 157, "t": "(بيان من يقطع بالجنان لهم)", "d": 0, "pg": 242, "j": "2", "sz": 8642}, {"i": 158, "t": "تأتي الملائكة بأبي بكر مع النبيئين تزفه", "d": 0, "pg": 243, "j": "2", "sz": 1470}, {"i": 159, "t": "كان إسلام عمر عزا وهجرته نصرا وإمارته رحمة", "d": 0, "pg": 244, "j": "2", "sz": 1431}, {"i": 160, "t": "والله ليشفعن عثمان في سبعين ألفا من أمته", "d": 0, "pg": 245, "j": "2", "sz": 1343}, {"i": 161, "t": "وهو أول من أذن للنبي صلى الله تعالى عليه وسلم", "d": 0, "pg": 248, "j": "2", "sz": 8301}, {"i": 162, "t": "جبريل أعان حسان بسبعين بيتا", "d": 0, "pg": 254, "j": "2", "sz": 34953}, {"i": 163, "t": "(ذكر دوابه عليه أفضل صلاة ربي)", "d": 0, "pg": 255, "j": "2", "sz": 1540}, {"i": 164, "t": "(بيان ما له من السلاح)", "d": 0, "pg": 279, "j": "2", "sz": 1549}, {"i": 165, "t": "أنها تأكل ولم تشرب بعد موته عليه السلام", "d": 0, "pg": 279, "j": "2", "sz": 660}, {"i": 166, "t": "لا سيف إلا ذو الفقار ولا فتى إلا علي", "d": 0, "pg": 280, "j": "2", "sz": 2939}, {"i": 167, "t": "من الأسياف السبعة التي أهدت بلقيس إلى سليمان", "d": 0, "pg": 282, "j": "2", "sz": 6039}, {"i": 168, "t": "درع داوود التي لبسها حين قتل جالوت", "d": 0, "pg": 286, "j": "2", "sz": 21525}, {"i": 169, "t": "(بيان ما له من الثياب)", "d": 0, "pg": 290, "j": "2", "sz": 1431}, {"i": 170, "t": "تغسل للمرضى وتسقى لهم", "d": 0, "pg": 291, "j": "2", "sz": 1162}, {"i": 171, "t": "المباهات في الملابس والتزين بها", "d": 0, "pg": 293, "j": "2", "sz": 1488}, {"i": 172, "t": "تطلب الشفاء لملابستها لعرقه وبدنه", "d": 0, "pg": 296, "j": "2", "sz": 1509}, {"i": 173, "t": "من جر شيئا من ذلك خيلاء لم ينظر الله إليه", "d": 0, "pg": 298, "j": "2", "sz": 1431}, {"i": 174, "t": "إذا قام من الليل يشوص فاه بالسواك", "d": 0, "pg": 301, "j": "2", "sz": 4001}, {"i": 175, "t": "فراش للرجل وفراش لامرأته والثالث للضيف", "d": 0, "pg": 304, "j": "2", "sz": 1920}, {"i": 176, "t": "كسرى وقيصر على الخز والديباج", "d": 0, "pg": 305, "j": "2", "sz": 8116}, {"i": 177, "t": "فطلبته الناس يحملون عليه موتاهم", "d": 0, "pg": 311, "j": "2", "sz": 2363}, {"i": 178, "t": "لأن صيانة العرض بترك سنة واجب", "d": 0, "pg": 312, "j": "2", "sz": 18180}, {"i": 179, "t": "من أمسك تمثالها متبركا به آمن من بغى البغاة", "d": 0, "pg": 319, "j": "2", "sz": 1551}, {"i": 180, "t": "واجعله في منى هذا الشرح رجاء لبركته", "d": 0, "pg": 321, "j": "2", "sz": 1476}, {"i": 181, "t": "النعل", "d": 0, "pg": 325, "j": "2", "sz": 1859}, {"i": 182, "t": "(بيان بعض معجزات المصطفى)", "d": 0, "pg": 327, "j": "2", "sz": 18259}, {"i": 183, "t": "فجعلها مائة قلوص إلى تسع سنين", "d": 0, "pg": 334, "j": "2", "sz": 1496}, {"i": 184, "t": "ولنذكر أولا حديث مسلم في الإسراء", "d": 0, "pg": 338, "j": "2", "sz": 9928}, {"i": 185, "t": "ها أنت وربك فهذا مقامي لا أتعداه", "d": 0, "pg": 343, "j": "2", "sz": 1630}, {"i": 186, "t": "من قام بعشر آيات لم يكتب من الغافلين", "d": 0, "pg": 344, "j": "2", "sz": 8196}, {"i": 187, "t": "يا محمد ارفع رأسك سل تعط واشفع تشفع", "d": 0, "pg": 346, "j": "2", "sz": 1672}, {"i": 188, "t": "اقتلع قرى قوم لوط وحملها على جناحه", "d": 0, "pg": 349, "j": "2", "sz": 3510}, {"i": 189, "t": "لم يكن الوجوب مبرما", "d": 0, "pg": 352, "j": "2", "sz": 6415}, {"i": 190, "t": "وذكره ابن الجوزي في الموضوعات فأخطأ", "d": 0, "pg": 356, "j": "2", "sz": 10580}, {"i": 191, "t": "إن فيه لعنكبوتا أقدم من ميلاد محمد", "d": 0, "pg": 363, "j": "2", "sz": 3223}, {"i": 192, "t": "الحمد لله الذي سلبهما كسرى بن هرمز", "d": 0, "pg": 365, "j": "2", "sz": 2361}, {"i": 193, "t": "والأصح أنها نعجة بيضاء", "d": 0, "pg": 366, "j": "2", "sz": 16525}, {"i": 194, "t": "بشر المشائين في الظلم إلى المساجد", "d": 0, "pg": 371, "j": "2", "sz": 1530}, {"i": 195, "t": "(وأخبرتك الشاة بعد الشي بأنها سمت", "d": 0, "pg": 374, "j": "2", "sz": 1568}, {"i": 196, "t": "فقال له جزاءا لي يا رسول الله", "d": 0, "pg": 375, "j": "2", "sz": 1648}, {"i": 197, "t": "وأما سجود الجمل له فعن أنس", "d": 0, "pg": 377, "j": "2", "sz": 868}, {"i": 198, "t": "لأمرت المرأة أن تسجد لزوجها من عظم حقه", "d": 0, "pg": 377, "j": "2", "sz": 8900}, {"i": 199, "t": "لا حاجة لي بهما وجدت الله خيرا لي منهما", "d": 0, "pg": 383, "j": "2", "sz": 6987}, {"i": 200, "t": "بل تغرسني في الجنة فيأكل مني أولياء الله", "d": 0, "pg": 387, "j": "2", "sz": 8876}, {"i": 201, "t": "اللهم إني أسألك وأتوجه إليك بنبيك محمد", "d": 0, "pg": 390, "j": "2", "sz": 1596}, {"i": 202, "t": "ما أرسل الرحمن أو يرسل", "d": 0, "pg": 391, "j": "2", "sz": 1436}, {"i": 203, "t": "وكان عتبة أطيب منهن ريحا مع أنه لا يمس طيبا", "d": 0, "pg": 393, "j": "2", "sz": 8887}, {"i": 204, "t": "ودعا لمعاوية بالتمكين في البلاد فنال ذلك", "d": 0, "pg": 399, "j": "2", "sz": 2800}, {"i": 205, "t": "فجاء الأسد يتشمم وجوههم حتى ضرب عتيبة", "d": 0, "pg": 400, "j": "2", "sz": 3004}, {"i": 206, "t": "وهاتان العلامتان لم تكونا منذ خلقت الدنيا", "d": 0, "pg": 402, "j": "2", "sz": 3798}, {"i": 207, "t": "ومنها أن آدم وجميع المخلوقات خلقوا لأجله", "d": 0, "pg": 405, "j": "2", "sz": 543}, {"i": 208, "t": "(ذكر وفاته صلاة ربه عليه)", "d": 0, "pg": 405, "j": "2", "sz": 6740}, {"i": 209, "t": "اللهم في الرفيق الأعلى", "d": 0, "pg": 410, "j": "2", "sz": 3856}, {"i": 210, "t": "من تصبح بسبع تمرات عجوة لم يضره", "d": 0, "pg": 412, "j": "2", "sz": 8117}, {"i": 211, "t": "ومنها مده يده لسيدي أحمد الرفاعي", "d": 0, "pg": 415, "j": "2", "sz": 1243}, {"i": 212, "t": "من كان يعبد محمدا فإن محمدا قد مات", "d": 0, "pg": 418, "j": "2", "sz": 4674}, {"i": 213, "t": "(وجاء الخضر معزيا لهم)", "d": 0, "pg": 421, "j": "2", "sz": 19663}, {"i": 214, "t": "يا روضة طاب منها الرق والقلم", "d": 0, "pg": 435, "j": "2", "sz": 4221}, {"i": 215, "t": "(بيان ما له من الأسماء)", "d": 0, "pg": 438, "j": "2", "sz": 4}, {"i": 216, "t": "من رآه بديهة هابه", "d": 0, "pg": 440, "j": "2", "sz": 4747}, {"i": 217, "t": "لولا هو ﵇ ما خلق قمر ولا شمس ولا بر", "d": 0, "pg": 443, "j": "2", "sz": 1647}, {"i": 218, "t": "تقول فيه بلسان ناعت أبلج وجه", "d": 0, "pg": 445, "j": "2", "sz": 17916}, {"i": 219, "t": "أرى كل مدح في النبي مقصرا", "d": 0, "pg": 453, "j": "2", "sz": 1458}, {"i": 220, "t": "فيقول يا رب أمتي أمتي", "d": 0, "pg": 455, "j": "2", "sz": 1621}, {"i": 221, "t": "من العباد من ينسي الله حفظته ذنوبه", "d": 0, "pg": 457, "j": "2", "sz": 14087}, {"i": 222, "t": "وأنا توسلنا إليك بعم نبينا فاسقنا", "d": 0, "pg": 458, "j": "2", "sz": 1216}, {"i": 223, "t": "الراحمون يرحمهم الله", "d": 0, "pg": 467, "j": "2", "sz": 11188}, {"i": 224, "t": "تعرض عليه أعمال أمته يستغفر لهم", "d": 0, "pg": 471, "j": "2", "sz": 1553}, {"i": 225, "t": "اختلف في عدة الصحابة الذين توفى ﷺ عنهم", "d": 0, "pg": 473, "j": "2", "sz": 1259}]}